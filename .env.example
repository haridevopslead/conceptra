# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Anthropic AI
ANTHROPIC_API_KEY="sk-ant-..."

# Groq (Whisper speech-to-text for voice input)
GROQ_API_KEY="gsk_..."

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth sign-in — Google, GitHub, LinkedIn
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
# Webhook secret — set when adding the endpoint in the Razorpay dashboard
# (Settings > Webhooks). This is NOT the same value as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Protects app/api/cron/downgrade-expired-plans — any random long string.
# Vercel automatically sends it as "Authorization: Bearer <value>" when
# triggering scheduled cron jobs (see vercel.json), so nothing else needs
# to be configured for that call to authenticate.
CRON_SECRET="a-long-random-string"

# Resend (Email) — used for email verification on signup
RESEND_API_KEY="re_..."
# Optional — sender address for a domain verified in the Resend dashboard.
# Falls back to Resend's shared sandbox sender (onboarding@resend.dev) if unset,
# which only delivers to the email the Resend account itself is registered with.
# RESEND_FROM_EMAIL="Conceptra <noreply@conceptra.in>"
