generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Role {
  USER
  ADMIN
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?

  role           Role      @default(USER)
  plan           Plan      @default(FREE)
  planExpiresAt  DateTime?

  currentStreak    Int       @default(0)
  lastSessionDate  DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  interviewSessions InterviewSession[]
  lessonProgress    UserLessonProgress[]
  aiUsage           AiUsage[]
  hariSessionLogs   HariSessionLog[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  expires      DateTime

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// NextAuth supporting models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Content models
// ---------------------------------------------------------------------------

model Lesson {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  category        String   @default("Uncategorized")
  difficulty      String   @default("Beginner")
  durationMinutes Int      @default(20)
  topics          String[] @default([])
  content         Json
  tier            Plan     @default(FREE)
  order           Int      @default(0)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InterviewSession {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score                     Int
  depthScore                Int?
  accuracyScore             Int?
  productionAwarenessScore  Int?
  topic                     String?
  question                  String?
  answer                    String?
  directAnswer              String?
  concreteExample           String?
  seniorInsight             String?
  bookmarked                Boolean  @default(false)
  createdAt                 DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, bookmarked])
}

// Conversation-level usage log for AI features that don't otherwise persist
// a per-call record (e.g. Interview with Dev's streaming chat). One row per
// conversation, not per message turn — see lib/ai-quota.ts. Quick Practice
// doesn't need a row here since InterviewSession already logs one row per
// graded answer and is used directly for that quota.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// One row per Interview with Hari session, written for every plan so the
// data exists regardless of tier — only the PRO/ENTERPRISE prompt-building
// path in app/api/interview/dev/route.ts actually reads it back (for
// no-repeat opening questions); FREE reads it only to power the upgrade
// nudge on app/interview/dev's setup screen.
model HariSessionLog {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic              String
  difficulty         String
  openingQuestion    String   @db.Text
  followUpQuestions  String[] @default([])
  createdAt          DateTime @default(now())

  @@index([userId, topic, createdAt])
}

model UserLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonSlug  String
  visitedAt   DateTime  @default(now())
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonSlug])
  @@index([userId])
}
