generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Role {
  USER
  ADMIN
}

// Add a value here (and a migration) when a new AI-calling feature ships —
// TTS is the known next one, see lib/ai-pricing.ts.
enum AiFeature {
  HARI_CHAT
  QUICK_PRACTICE
  TRANSCRIBE
}

enum PlanDuration {
  MONTHLY
  QUARTERLY
  ANNUAL
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?

  role           Role      @default(USER)
  plan           Plan      @default(FREE)
  planExpiresAt  DateTime?

  currentStreak    Int       @default(0)
  lastSessionDate  DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  interviewSessions InterviewSession[]
  lessonProgress    UserLessonProgress[]
  aiUsage           AiUsage[]
  hariSessionLogs   HariSessionLog[]
  hariWeakAreas     HariWeakArea[]
  aiCostLogs        AiCostLog[]
  payments          Payment[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  expires      DateTime

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// NextAuth supporting models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Content models
// ---------------------------------------------------------------------------

model Lesson {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  category        String   @default("Uncategorized")
  difficulty      String   @default("Beginner")
  durationMinutes Int      @default(20)
  topics          String[] @default([])
  content         Json
  tier            Plan     @default(FREE)
  order           Int      @default(0)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InterviewSession {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score                     Int
  depthScore                Int?
  accuracyScore             Int?
  productionAwarenessScore  Int?
  topic                     String?
  question                  String?
  answer                    String?
  directAnswer              String?
  concreteExample           String?
  seniorInsight             String?
  bookmarked                Boolean  @default(false)
  createdAt                 DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, bookmarked])
}

// Conversation-level usage log for AI features that don't otherwise persist
// a per-call record (e.g. Interview with Dev's streaming chat). One row per
// conversation, not per message turn — see lib/ai-quota.ts. Quick Practice
// doesn't need a row here since InterviewSession already logs one row per
// graded answer and is used directly for that quota.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// One row per Interview with Hari session, written for every plan so the
// data exists regardless of tier — only the PRO/ENTERPRISE prompt-building
// path in app/api/interview/dev/route.ts actually reads it back (for
// no-repeat opening questions); FREE reads it only to power the upgrade
// nudge on app/interview/dev's setup screen.
model HariSessionLog {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic              String
  difficulty         String
  openingQuestion    String   @db.Text
  followUpQuestions  String[] @default([])
  createdAt          DateTime @default(now())

  @@index([userId, topic, createdAt])
}

// One row per weak concept flagged at the end of a PRO Hari session (e.g.
// "Docker layer caching", not just "Docker") — extracted by the same model
// call that produces the end-of-conversation feedback, via a tool call, and
// written best-effort (see app/api/interview/dev/route.ts). Not deduped at
// write time: repeated concepts across sessions are useful signal for later
// reads. Nothing reads this yet — piece 3 will query it for session-start
// prompting, piece 4 will build UI on top of it.
model HariWeakArea {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String
  concept   String
  createdAt DateTime @default(now())

  @@index([userId, topic])
}

// One row per real AI provider call (Claude or Groq), written so pricing
// decisions can be based on measured usage instead of estimates — see
// lib/ai-pricing.ts for the per-unit rates computedCostUsd is derived from
// at write time. Raw usage (tokens/seconds/chars) is stored alongside the
// computed dollar figure, not instead of it, so historical rows can be
// re-priced later if a provider's rate changes. Not every field applies to
// every feature: HARI_CHAT/QUICK_PRACTICE use input/outputTokens, TRANSCRIBE
// uses audioSeconds, a future TTS feature would use characterCount.
model AiCostLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature         AiFeature
  inputTokens     Int?
  outputTokens    Int?
  audioSeconds    Float?
  characterCount  Int?
  computedCostUsd Decimal   @db.Decimal(12, 6)
  createdAt       DateTime  @default(now())

  @@index([userId, feature, createdAt])
  @@index([feature, createdAt])
}

// One row per successfully processed Razorpay payment — written once, by
// whichever of verify (client-side, fires right after checkout) or webhook
// (payment.captured, Razorpay's server-to-server backstop) gets there first.
// razorpayPaymentId is unique specifically so that path can double as the
// idempotency guard: both call sites attempt to insert here before ever
// touching User.plan/planExpiresAt, so a duplicate webhook delivery or a
// verify+webhook race for the same payment applies the upgrade exactly once.
// See lib/apply-pro-upgrade.ts.
model Payment {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayOrderId   String
  razorpayPaymentId String       @unique
  amountPaise       Int
  duration          PlanDuration
  createdAt         DateTime     @default(now())

  @@index([userId])
}

model UserLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonSlug  String
  visitedAt   DateTime  @default(now())
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonSlug])
  @@index([userId])
}
